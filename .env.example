PORT=3000
# Generate with: npm run generate:jwt-secret
JWT_SECRET=replace-with-a-random-64-byte-hex-secret

# Aiven MySQL
# You can use DATABASE_URL or the separate DB_* variables below.
# DATABASE_URL=mysql://avnadmin:your-password@your-aiven-host.aivencloud.com:12345/defaultdb
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true

# Optional but recommended: paste Aiven's CA certificate here, or set this to a deployed file path.
# If this is empty, the app still uses SSL but skips certificate verification.
# For env vars, keep the certificate as one value and use \n for line breaks if needed.
DB_SSL_CA=

# Local MySQL example:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=medical_record_system
# DB_SSL=false
