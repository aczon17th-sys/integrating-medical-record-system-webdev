<%- include('../partials/header') %>
<section class="page-heading">
  <div>
    <p class="eyebrow">Patient portal</p>
    <h1>My Appointments</h1>
  </div>
</section>

<section class="panel">
  <h2>Request Appointment</h2>
  <form class="form-grid" action="/patient/appointments" method="post">
    <label>Preferred doctor
      <select name="doctor_id">
        <option value="">Any available doctor</option>
        <% doctors.forEach(doctor => { %>
          <option value="<%= doctor.id %>">Dr. <%= doctor.last_name %>, <%= doctor.first_name %></option>
        <% }) %>
      </select>
    </label>
    <label>Date and time<input type="datetime-local" name="scheduled_at" required></label>
    <label class="span-2">Reason<textarea name="reason"></textarea></label>
    <button class="button" type="submit">Submit request</button>
  </form>
</section>

<section class="panel">
  <h2>Appointment History</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Doctor</th><th>Schedule</th><th>Reason</th><th>Status</th></tr></thead>
      <tbody>
        <% appointments.forEach(item => { %>
          <tr>
            <td><%= item.doctor_first ? `Dr. ${item.doctor_first} ${item.doctor_last}` : 'Unassigned' %></td>
            <td><%= item.scheduled_at.toLocaleString() %></td>
            <td><%= item.reason || '-' %></td>
            <td><span class="badge"><%= item.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
